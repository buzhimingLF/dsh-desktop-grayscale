+                while (i < text.length) {
+                    if (!thinkInTag) {
+                        const openIdx = text.indexOf(OPEN_THINK, i);
+                        if (openIdx === -1) {
+                            const partial = partialTagLen(text.slice(i), OPEN_THINK);
+                            if (partial > 0) {
+                                thinkTail = text.slice(text.length - partial);
+                                outText += text.slice(i, text.length - partial);
+                            }
+                            else {
+                                outText += text.slice(i);
+                            }
+                            break;
+                        }
